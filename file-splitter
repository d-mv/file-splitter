#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  LINK_TARGET="$(readlink "$SOURCE")"
  if [[ "$LINK_TARGET" = /* ]]; then
    SOURCE="$LINK_TARGET"
  else
    SOURCE="$(cd "$(dirname "$SOURCE")" && pwd)/$LINK_TARGET"
  fi
done
ROOT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"

if [[ -f "$ROOT_DIR/dist/cli.js" ]]; then
  node "$ROOT_DIR/dist/cli.js" "$@"
else
  node "$ROOT_DIR/node_modules/.bin/tsx" "$ROOT_DIR/src/cli.ts" "$@"
fi
